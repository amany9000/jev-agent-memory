# ---------------------------------------------------------------------------
# Neo4j Aura — copy these from the credentials .txt Aura downloads when you
# create the instance (console.neo4j.io → your instance → Connect).
# ---------------------------------------------------------------------------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Usually "neo4j". Newer Aura credential files list it as NEO4J_DATABASE — use that value.
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# TypeSafe — the graph maker (https://typesafe.ai)
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=
# Optional model override; `make check-typesafe` lists the models on your account.
TYPESAFE_DEFAULT_MODEL=

# ---------------------------------------------------------------------------
# GLiNER — candidate span finder (runs locally; first use downloads ~800 MB)
# ---------------------------------------------------------------------------
GLINER_MODEL=gliner-community/gliner_medium-v2.5
# Low = more candidates (recall); TypeSafe discards the noise.
GLINER_THRESHOLD=0.3
# cpu | mps (Apple Silicon) | cuda
GLINER_DEVICE=cpu

# ---------------------------------------------------------------------------
# OpenAI — required for the default (OpenAI) embeddings.
# The same key also gives the agent a real chat model after `make install-openai`.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---------------------------------------------------------------------------
# Embeddings. Do NOT change after the first ingest: the Neo4j vector index is
# created with this model's dimension.
#   openai/text-embedding-3-small            1536 dims (default, needs OPENAI_API_KEY)
#   openai/text-embedding-3-large            3072 dims
#   sentence-transformers/all-MiniLM-L6-v2    384 dims (local, no key)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=openai/text-embedding-3-small

# Memory sessions used by the POC
INGEST_SESSION_ID=typesafe-poc-ingest
CHAT_SESSION_ID=typesafe-poc-chat
