# --- Neo4j Aura (console.neo4j.io → your instance → Connect) ---------------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- TypeSafe (https://typesafe.ai) -----------------------------------------
TYPESAFE_API_KEY=

# --- Extractor: USE_SPACY=true -> spaCy+GLiNER, false -> TypeSafeExtractor --
USE_SPACY=false
SPACY_MODEL=en_core_web_trf
GLINER_MODEL=gliner-community/gliner_medium-v2.5
GLINER_THRESHOLD=0.5
GLINER_DEVICE=cpu

# --- Embeddings (don't change after first ingest without fix-vector-indexes)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- DeepSeek chat model for the agent (optional) ---------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

INGEST_SESSION_ID=typesafe-poc-ingest
CHAT_SESSION_ID=typesafe-poc-chat

# Hugging Face token, for GLiNER/FastEmbed model downloads
HF_TOKEN=