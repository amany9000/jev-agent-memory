# ---------------------------------------------------------------------------
# Neo4j Aura — copy these from the credentials .txt Aura downloads when you
# create the instance (console.neo4j.io → your instance → Connect).
# ---------------------------------------------------------------------------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Usually "neo4j". Newer Aura credential files list it as NEO4J_DATABASE — use that value.
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# TypeSafe — the graph maker (https://typesafe.ai)
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# GLiNER — candidate span finder (runs locally; first use downloads ~800 MB)
# ---------------------------------------------------------------------------
GLINER_MODEL=gliner-community/gliner_medium-v2.5
# Low = more candidates (recall); TypeSafe discards the noise.
GLINER_THRESHOLD=0.3
# cpu | mps (Apple Silicon) | cuda
GLINER_DEVICE=cpu

# ---------------------------------------------------------------------------
# Embeddings — FastEmbed, runs locally, no key (first use downloads ~70 MB).
# Do NOT change after the first ingest: the Neo4j vector indexes are sized to
# the model (bge-small = 384 dims). If you do, run `make fix-vector-indexes`.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# DeepSeek — chat model for the agent (https://platform.deepseek.com).
# Optional: without a key the agent runs on a scripted fake model.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Memory sessions used by the POC
INGEST_SESSION_ID=typesafe-poc-ingest
CHAT_SESSION_ID=typesafe-poc-chat

# Hugging Face Token for downloading models (GLiNER, FastEmbed, etc.) from the Hugging Face Hub.
HF_TOKEN=